APP_NAME=MONEYTEAM / NexusPipe Pro
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
STORAGE_DIR=/app/storage
TRADING_MODE=paper
FINANCIAL_MODE=sandbox

REQUIRE_AUTH=true
ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
ALLOW_LIVE_EXECUTION=false
REQUIRE_HUMAN_APPROVAL=true
LIVE_APPROVAL_TOKEN=GENERATE_A_SEPARATE_APPROVAL_SECRET
KILL_SWITCH=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE=false

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_LIVE=false

CORS_ORIGINS=https://YOUR_DOMAIN
TRUSTED_HOSTS=YOUR_DOMAIN
RATE_LIMIT_PER_MINUTE=60
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
WEBHOOK_REPLAY_SECONDS=300
BACKUP_REQUIRED=true
MONITORING_ENABLED=true
SENTRY_DSN=
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2
